# Environment Configuration Example for DeLong Protocol
# Copy this file to .env and fill in your actual values

# ============================================================================
# GENERAL SETTINGS
# ============================================================================
ENVIRONMENT=development

# Global configuration debug (shows which config files are loaded)
CONFIG_DEBUG=false

# Global Rust log level (applies to all services if not overridden)
RUST_LOG=info

# ============================================================================
# GATEWAY SERVICE CONFIGURATION (Port 11111)
# ============================================================================

# Server Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=11111
GATEWAY_TIMEOUT_SECONDS=30

# Backend Services Configuration
GATEWAY_CORE_SERVICE_URL=http://localhost:11112
GATEWAY_SECURE_SERVICE_URL=http://localhost:11113

# API Configuration
GATEWAY_MAX_BODY_SIZE=10485760
GATEWAY_ENABLE_API_KEY_VALIDATION=true

# Logging Configuration
GATEWAY_LOG_LEVEL=info
GATEWAY_LOG_JSON_FORMAT=false
GATEWAY_LOG_HEALTH_CHECKS=false
GATEWAY_LOG_REQUEST_HEADERS=false
GATEWAY_LOG_REQUEST_BODY=false
GATEWAY_LOG_MAX_BODY_SIZE=1024
GATEWAY_LOG_RESPONSE_BODY=false

# OpenTelemetry Configuration
GATEWAY_OTEL_ENABLED=false
GATEWAY_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
GATEWAY_OTEL_SERVICE_NAME=delong-gateway
GATEWAY_OTEL_SERVICE_VERSION=0.2.0

# Redis Configuration
GATEWAY_REDIS_URL=redis://localhost:6379
GATEWAY_REDIS_ENABLED=true
GATEWAY_REDIS_POOL_SIZE=10
GATEWAY_REDIS_CONNECTION_TIMEOUT=5
GATEWAY_REDIS_DEFAULT_TTL=3600
GATEWAY_REDIS_JWT_CACHE_TTL=1800
GATEWAY_REDIS_API_KEY_CACHE_TTL=3600

# ============================================================================
# CORE SERVICE CONFIGURATION (Port 11112)
# ============================================================================

# Server Configuration
CORE_HOST=0.0.0.0
CORE_PORT=11112
CORE_TIMEOUT_SECONDS=30

# Database Configuration
CORE_DATABASE_URL=postgresql://delong_user:your_password_here@localhost:5432/delong_protocol
CORE_DATABASE_MAX_CONNECTIONS=20
CORE_DATABASE_CONNECT_TIMEOUT=30
CORE_DATABASE_QUERY_TIMEOUT=30
CORE_DATABASE_AUTO_MIGRATE=true

# JWT Configuration
CORE_JWT_SECRET=your-super-secret-jwt-key-change-in-production

# API Configuration
CORE_ENABLE_API_KEY_VALIDATION=false
CORE_DEFAULT_KEY_EXPIRATION_DAYS=30
CORE_MAX_KEYS_PER_USER=10
CORE_ENABLE_RATE_LIMITING=false

# Development Configuration
CORE_DEVELOPMENT_MODE=true

# External Services
CORE_AI_AUDIT_SERVICE_URL=https://api.aiaudit.com

# Logging Configuration
CORE_LOG_LEVEL=info
CORE_LOG_JSON_FORMAT=false

# OpenTelemetry Configuration
CORE_OTEL_ENABLED=false
CORE_OTEL_SERVICE_NAME=delong-core
CORE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Redis Configuration (Optional)
CORE_REDIS_URL=redis://localhost:6379

# ============================================================================
# SHARED CONFIGURATION (Used by multiple services)
# ============================================================================

# Shared Redis Configuration
SHARED_REDIS_URL=redis://localhost:6379
SHARED_REDIS_ENABLED=true

# Shared Logging Configuration
SHARED_LOG_LEVEL=info
SHARED_LOG_JSON_FORMAT=false

# Shared OpenTelemetry Configuration
SHARED_OTEL_ENABLED=false
SHARED_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ============================================================================
# DOCKER COMPOSE SPECIFIC SETTINGS
# ============================================================================

# Database Password (used by Docker Compose)
POSTGRES_PASSWORD=secure_password

# Redis Password (used by Docker Compose)
REDIS_PASSWORD=redis_password

# Service Base URLs (for Docker Compose internal communication)
GATEWAY_BASE_URL=http://localhost:11111
CORE_BASE_URL=http://localhost:11112
SECURE_BASE_URL=http://localhost:11113

# External Services
SECURE_SERVICE_URL=http://localhost:11113
DATA_PIPELINE_URL=http://datapipe:8018

# OpenTelemetry (Global Settings)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Log Level Override
LOG_LEVEL=info

# ============================================================================
# NOTES
# ============================================================================
# 1. Copy this file to .env for Docker Compose usage
# 2. Environment variables have priority: SERVICE_* > SHARED_* > plain key
# 3. Gateway service uses EnvLoader with "gateway" prefix
# 4. Core service uses EnvLoader with "core" prefix
# 5. Port allocation: Gateway(11111), Core(11112), Secure(11113), DataPipe(8018)
# 6. Only variables actually used by the services are included
