# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=11000
SERVER_WORKERS=4

# Database Configuration
DATABASE_URL=postgres://secure_user:secure_dev_password@localhost:5432/secure_db
DATABASE_MAX_CONNECTIONS=32
DATABASE_MIN_CONNECTIONS=1
DATABASE_CONNECT_TIMEOUT=30
DATABASE_IDLE_TIMEOUT=600

# Runtime Configuration
RUNTIME_MAX_EXECUTION_TIME=3600
RUNTIME_MAX_MEMORY=1024
RUNTIME_WORKER_THREADS=4
RUNTIME_QUEUE_SIZE=100
RUNTIME_MAX_CONCURRENT_EXECUTIONS=10
RUNTIME_WORKING_DIRECTORY=/tmp/delong-runtime
RUNTIME_PYTHON_PATH=python3
RUNTIME_POLL_INTERVAL=5

# IPFS Configuration
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_URL=http://localhost:8080
IPFS_TIMEOUT=30

# Blockchain Configuration
CHAIN_RPC_URL=http://localhost:8545
CHAIN_ID=31337
CHAIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_SYNC_INTERVAL=10
CHAIN_SYNC_BATCH_SIZE=1000
CHAIN_BLOCK_BATCH_SIZE=100

# TEE Configuration
TEE_ENABLED=false
TEE_ATTESTATION_PROVIDER=sgx
# TEE_MEASUREMENT_FILE=/path/to/measurement/file

# Redis Configuration (for cache)
REDIS_URL=redis://:secure_redis_dev_password@localhost:6379/0

# Logging Configuration
RUST_LOG=debug,secure=trace
RUST_BACKTRACE=1

# Development Settings
ENVIRONMENT=development
