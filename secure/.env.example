# Secure Service Configuration
# Copy this file to .env and adjust the values as needed

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=11000
SERVER_WORKERS=4

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://secure_user:secure_dev_password@localhost:5432/secure_db
DATABASE_MAX_CONNECTIONS=32
DATABASE_MIN_CONNECTIONS=1
DATABASE_CONNECT_TIMEOUT=30
DATABASE_IDLE_TIMEOUT=600

# Runtime Configuration
RUNTIME_MAX_EXECUTION_TIME=3600
RUNTIME_MAX_MEMORY=1024
RUNTIME_WORKER_THREADS=4
RUNTIME_QUEUE_SIZE=100
RUNTIME_MAX_CONCURRENT_EXECUTIONS=10
RUNTIME_WORKING_DIRECTORY=/tmp/delong-runtime
RUNTIME_PYTHON_PATH=python3
RUNTIME_POLL_INTERVAL=60

# IPFS Configuration
IPFS_API_URL=http://localhost:11004
IPFS_GATEWAY_URL=http://localhost:11005
IPFS_TIMEOUT=30

# Blockchain Configuration
CHAIN_RPC_URL=http://localhost:11003
CHAIN_WS_URL=ws://localhost:11003
CHAIN_ID=31337
CHAIN_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
CHAIN_SYNC_INTERVAL=60
CHAIN_SYNC_BATCH_SIZE=1000
CHAIN_BLOCK_BATCH_SIZE=100

# Optional: Path to TOML config file (overrides environment variables)
# CONFIG_PATH=/path/to/config.toml

# TEE Configuration
TEE_ENABLED=true
TEE_CLIENT_KIND=tappd

# Redis Configuration (for cache)
REDIS_URL=redis://:secure_redis_dev_password@localhost:11002/0

# Logging Configuration
RUST_LOG=debug,secure=trace
RUST_BACKTRACE=1

# Committee Configuration
COMMITTEE_SIZE=3

# Dataset Configuration
DATASET_SAMPLE_SIZE=100

# Development Settings
ENVIRONMENT=development
