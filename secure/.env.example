# Secure Service Configuration
# Copy this file to .env and adjust the values as needed

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=11000
SERVER_WORKERS=4

# Logging Configuration
RUST_LOG=info
RUST_BACKTRACE=1

# Development Settings
ENVIRONMENT=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://secure_user:secure_dev_password@localhost:11001/secure_db
DATABASE_MAX_CONNECTIONS=32
DATABASE_MAX_CONNECTIONS=32
DATABASE_MAX_CONNECTIONS=32
DATABASE_MAX_CONNECTIONS=32
DATABASE_MAX_CONNECTIONS=32
DATABASE_MAX_CONNECTIONS=32
DATABASE_MIN_CONNECTIONS=1
DATABASE_CONNECT_TIMEOUT=30
DATABASE_IDLE_TIMEOUT=600

# Executor Configuration
EXECUTOR_BUILD_SIZE_LIMIT=104857600
EXECUTOR_EXECUTION_TIMEOUT=3600
EXECUTOR_WORKING_DIRECTORY=/tmp/delong-runtime
EXECUTOR_MAX_CONCURRENT_EXECUTIONS=10
EXECUTOR_DATASET_BASE_PATH=/tmp/datasets

# IPFS Configuration
IPFS_API_URL=http://localhost:11004
IPFS_GATEWAY_URL=http://localhost:11005
IPFS_TIMEOUT=30

# Blockchain Configuration
CHAIN_RPC_URL=http://localhost:11003
CHAIN_WS_URL=ws://localhost:11003
CHAIN_ID=31337
# Optional: Contract address (if already deployed)
# CHAIN_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Official Account Private Key for transactions
# For local testing with Anvil, use one of the default test accounts:
# Account #0: 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266 (10000 ETH)
# Private Key: 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
#
# Account #1: 0x70997970C51812dc3A010C7d01b50e0d17dc79C8 (10000 ETH)
# Private Key: 0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
#
# For testing, uncomment and use the first account:
# OFFICIAL_ACCOUNT_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
#
# For production, use your own secure private key
OFFICIAL_ACCOUNT_PRIVATE_KEY=your_private_key_here

CHAIN_CONFIRMATIONS=1
CHAIN_GAS_PRICE_MULTIPLIER=1.1
CHAIN_MAX_GAS_LIMIT=10000000
CHAIN_FUNDING_THRESHOLD_ETH=0.5
CHAIN_FUNDING_AMOUNT_ETH=1.0
CHAIN_SYNC_INTERVAL=10
CHAIN_SYNC_BATCH_SIZE=1000
CHAIN_BLOCK_BATCH_SIZE=100

# TEE Configuration
TEE_ENABLED=false
TEE_CLIENT_KIND=TAPPD

# Committee Configuration
COMMITTEE_SIZE=3

# Dataset Configuration
DATASET_SAMPLE_SIZE=100
DATASET_SAMPLE_API_URL=http://localhost:11008
