  "query": "\n            INSERT INTO committee_members (member_wallet, is_approved)\n            VALUES ($1, $2)\n            ON CONFLICT (member_wallet)\n            DO UPDATE SET\n                is_approved = EXCLUDED.is_approved,\n                updated_at = NOW()\n            RETURNING *\n            ",
