  "query": "\n            SELECT id, tx_hash, entity_id,\n                   entity_type,\n                   status as \"status: _\",\n                   block_number, block_timestamp,\n                   created_at, updated_at\n            FROM blockchain_transaction\n            WHERE entity_id = $1 AND entity_type = $2 AND status = $3\n            ORDER BY created_at DESC\n            ",
