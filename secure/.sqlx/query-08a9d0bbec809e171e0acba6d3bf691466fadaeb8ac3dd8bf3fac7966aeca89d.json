  "db_name": "PostgreSQL",
  "query": "\n            SELECT committee_member.*\n            FROM committee_member\n            JOIN blockchain_transaction bt ON bt.entity_id = committee_member.id\n            WHERE bt.status = $1 AND bt.entity_type = $2\n            ORDER BY committee_member.created_at DESC\n            LIMIT $3 OFFSET $4\n            ",
