        "pieType": "donut",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum by (log_target) (count_over_time({service=\"delong-gateway\"} | json | __error__=\"\" [$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Logs by Module",
      "type": "piechart"
    }
  ],
