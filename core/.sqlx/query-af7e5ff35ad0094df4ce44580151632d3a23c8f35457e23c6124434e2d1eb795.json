{
  "db_name": "PostgreSQL",
  "query": "\n            UPDATE ai_audit_reports\n            SET status = $2,\n                risk_score = COALESCE($3, risk_score),\n                confidence_score = COALESCE($4, confidence_score),\n                findings = COALESCE($5, findings),\n                recommendations = COALESCE($6, recommendations),\n                completed_at = CASE WHEN $2 = 'completed'::ai_audit_status THEN NOW() ELSE completed_at END\n            WHERE id = $1\n            RETURNING id, dataset_id, algorithm_id, user_id, report_type, status as \"status: AiAuditStatus\",\n                      findings, recommendations, risk_score, confidence_score,\n                      created_at, completed_at, metadata\n            ",
