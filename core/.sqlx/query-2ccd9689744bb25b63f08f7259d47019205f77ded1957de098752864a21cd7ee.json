{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT p.id, p.name, p.description, p.permission_type as \"permission_type: PermissionType\", p.resource, p.created_at, p.updated_at\n                FROM permissions p\n                JOIN role_permissions rp ON p.id = rp.permission_id\n                WHERE rp.role_id = $1\n                ",
