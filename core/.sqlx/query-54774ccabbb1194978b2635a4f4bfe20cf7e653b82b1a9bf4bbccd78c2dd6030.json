  "db_name": "PostgreSQL",
  "query": "\n            INSERT INTO votes (user_id, target_type, target_id, vote_type, weight)\n            VALUES ($1, $2, $3, $4, $5)\n            ON CONFLICT (user_id, target_type, target_id)\n            DO UPDATE SET\n                vote_type = EXCLUDED.vote_type,\n                weight = EXCLUDED.weight,\n                updated_at = NOW()\n            RETURNING id, user_id, target_type, target_id, vote_type as \"vote_type: VoteType\",\n                      weight, created_at, updated_at, metadata\n            ",
