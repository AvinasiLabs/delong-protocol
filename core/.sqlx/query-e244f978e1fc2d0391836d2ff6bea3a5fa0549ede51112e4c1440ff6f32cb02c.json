  "query": "\n            UPDATE api_keys\n            SET\n                name = $2,\n                permissions = $3,\n                is_active = $4,\n                expires_at = $5,\n                updated_at = NOW()\n            WHERE id = $1\n            RETURNING\n                id,\n                api_key,\n                name,\n                user_id,\n                permissions,\n                rate_limit_tier as \"rate_limit_tier: RateLimitTier\",\n                is_active,\n                expires_at,\n                last_used_at,\n                created_at,\n                updated_at\n            ",
