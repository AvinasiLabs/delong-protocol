{
  "db_name": "PostgreSQL",
  "query": "\n            UPDATE ai_audit_reports\n            SET\n                status = COALESCE($2, status),\n                findings = COALESCE($3, findings),\n                recommendations = COALESCE($4, recommendations),\n                risk_score = COALESCE($5, risk_score),\n                confidence_score = COALESCE($6, confidence_score),\n                metadata = COALESCE($7, metadata),\n                completed_at = CASE WHEN $2 = 'completed'::ai_audit_status THEN NOW() ELSE completed_at END\n            WHERE id = $1\n            RETURNING id, dataset_id, algorithm_id, user_id, report_type, status as \"status: AiAuditStatus\",\n                      findings, recommendations, risk_score, confidence_score,\n                      created_at, completed_at, metadata\n            ",
