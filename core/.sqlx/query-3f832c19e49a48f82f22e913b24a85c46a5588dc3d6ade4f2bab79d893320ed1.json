{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            id,\n            api_key,\n            name,\n            user_id,\n            permissions,\n            rate_limit_tier as \"rate_limit_tier: RateLimitTier\",\n            is_active,\n            expires_at,\n            last_used_at,\n            created_at,\n            updated_at\n        FROM api_keys\n        WHERE api_key = $1\n        AND is_active = true\n        AND (expires_at IS NULL OR expires_at > NOW())\n        ",
