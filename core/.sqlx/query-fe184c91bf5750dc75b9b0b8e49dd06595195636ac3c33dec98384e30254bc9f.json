{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, user_id, code, verification_type as \"verification_type: VerificationType\",\n                   expires_at, created_at, used_at, is_used, attempts, metadata\n            FROM verification_codes\n            WHERE code = $1 AND verification_type = $2 AND expires_at > NOW()\n            ORDER BY created_at DESC\n            LIMIT 1\n            ",
