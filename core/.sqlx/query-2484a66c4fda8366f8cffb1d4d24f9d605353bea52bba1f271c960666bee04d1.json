  "db_name": "PostgreSQL",
  "query": "\n            UPDATE users\n            SET\n                username = COALESCE($2, username),\n                email = COALESCE($3, email),\n                full_name = COALESCE($4, full_name),\n                status = COALESCE($5, status),\n                phone = COALESCE($6, phone),\n                bio = COALESCE($7, bio),\n                avatar_url = COALESCE($8, avatar_url),\n                email_verified = COALESCE($9, email_verified),\n                phone_verified = COALESCE($10, phone_verified),\n                preferences = COALESCE($11, preferences),\n                updated_at = NOW()\n            WHERE id = $1\n            RETURNING id, email, username, password_hash, role as \"role: _\", full_name, status as \"status: UserStatus\",\n                      email_verified, phone, phone_verified, avatar_url, bio,\n                      created_at, updated_at, last_login_at, login_attempts, locked_until,\n                      preferences, metadata\n            ",
