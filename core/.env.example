# Core Service Environment Variables

# Service Configuration
SERVICE_NAME=delong-core
SERVICE_PORT=11020
LOG_LEVEL=info

# Database Configuration
DATABASE_URL=postgresql://postgres:test_password@localhost:11021/db_core_test
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=2

# Redis Configuration
REDIS_URL=redis://localhost:11022
REDIS_MAX_CONNECTIONS=10

# Verification Configuration
VERIFICATION_EXPIRATION_MINUTES=15
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_USE_FIXED_CODE=false
VERIFICATION_FIXED_CODE=1234

# JWT Configuration
JWT_SECRET=test-secret-key-for-testing-only
JWT_EXPIRATION_HOURS=24

# Email Configuration
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@delong-protocol.com
SMTP_FROM_NAME=DeLong Protocol
SMTP_USE_TLS=true

# API Configuration
API_KEY_PREFIX=dlp_
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=60

# External Services
AI_AUDIT_SERVICE_URL=http://localhost:8082
AI_AUDIT_USE_MOCK=true
GITHUB_TOKEN=test-github-token

# Secure Service Proxy Configuration
SECURE_SERVICE_URL=http://localhost:11000
PROXY_TIMEOUT=30
PROXY_DEBUG=false
INTERNAL_JWT_EXPIRATION=60
PROXY_MAX_RETRIES=3

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# GOOGLE OAUTH CONFIGURATION
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_REDIRECT_URL=https://yourdomain.com/auth/google/callback

# siwe
SIWE_DOMAIN=localhost:3000
