# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# IDE
.zed
.idea

# NOTES
notes

# Gateway monitoring stack
# Keep configuration files, ignore runtime data
gateway/grafana-storage/
gateway/loki-storage/
gateway/jaeger-storage/
gateway/vector-data/
gateway/*.log
gateway/grafana/provisioning/notifiers/*
gateway/grafana/provisioning/access-control/*

# Docker volumes (if running locally)
volumes/

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Environment files (may contain secrets)
.env
.env.local
.env.production
.env.staging
.env.test
.env.development

# Docker override files
docker-compose.override.yml

# Keep example files (these should be committed)
!.env.example
