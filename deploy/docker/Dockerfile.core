# Multi-stage build for DeLong Protocol Core Service
FROM rust:1.85-bullseye AS builder

WORKDIR /app

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY common/ common/
COPY core/ core/

# Build dependencies first (for better caching)
RUN cargo build --release --package core

FROM debian:bullseye-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the binary from builder
COPY --from=builder /app/target/release/core .

# Create data directory for dynamic datasets
RUN mkdir -p /data/datasets

# Create non-root user
RUN groupadd -r delong && useradd -r -g delong delong
RUN chown -R delong:delong /app /data

USER delong

# Expose port
EXPOSE 8081

# Add health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8081/health || exit 1

CMD ["./core"] 